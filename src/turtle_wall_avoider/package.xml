<?xml version="1.0"?>
<package format="3">
  <name>turtle_wall_avoider</name>
  <version>0.1.0</version>
  <description>Moves a turtlesim turtle around an inset route without hitting the walls.</description>
  <maintainer email="user@example.com">ROS 2 User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>turtlesim</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
